{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "mk-magic-alerts": {
      "projectType": "library",
      "root": "projects/mk-magic-alerts",
      "sourceRoot": "projects/mk-magic-alerts/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/mk-magic-alerts/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/mk-magic-alerts/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/mk-magic-alerts/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
		"test": {
			"builder": "@angular/build:unit-test",
			"options": {
				"tsConfig": "tsconfig.spec.json",
				"runnerConfig": "vitest.config.ts",
				"providersFile": "projects/mk-magic-alerts/src/test-providers.ts",
				"coverage": true,
				"coverageInclude": [
					"projects/mk-magic-alerts/src/**/*.ts"
				],
				"coverageExclude": [
					"projects/mk-magic-alerts/src/**/*.spec.ts",
					"projects/mk-magic-alerts/src/test-providers.ts",
					"projects/mk-magic-alerts/src/public-api.ts",
					"projects/mk-magic-alerts/src/lib/**/*.module.ts",
					"projects/mk-magic-alerts/src/lib/**/mocks/**/*.ts",
					"projects/mk-magic-alerts/src/lib/**/test-helpers/**/*.ts"
				],
				"coverageReporters": [
					"html",
					"text",
					"text-summary",
					"lcov"
				]
			}
		}
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
